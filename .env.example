# =============================================================================
# NEXUS-STRIKE Configuration
# =============================================================================
# At least one LLM provider is required for full functionality.
# Without any, the system runs in MOCK mode for development/testing.

# ── OpenAI ──
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4-turbo
OPENAI_BASE_URL=

# ── Anthropic (Claude) ──
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-opus-20240229

# ── OpenRouter (Gateway to 200+ models) ──
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_MODEL=openai/gpt-4-turbo
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Ollama (Local LLMs) ──
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Azure OpenAI ──
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_MODEL=gpt-4

# ── Groq (Fast inference) ──
GROQ_API_KEY=gsk_...
GROQ_MODEL=mixtral-8x7b-32768
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── DeepSeek ──
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ── Omniroute (Multi-provider routing) ──
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=gpt-4
OMNIROUTE_BASE_URL=

# ── Custom OpenAI-Compatible Provider ──
CUSTOM_API_KEY=
CUSTOM_MODEL=custom-model
CUSTOM_BASE_URL=
CUSTOM_API_TYPE=openai  # openai, anthropic, or custom

# ── Default LLM Settings ──
LLM_PROVIDER=openai
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

# ── Execution ──
NEXUS_MODE=guided           # autonomous, guided, tool, interactive
NEXUS_LOG_LEVEL=INFO        # DEBUG, INFO, WARNING, ERROR
NEXUS_SANDBOX_ENABLED=true
NEXUS_AUTO_APPROVE=false
NEXUS_MAX_CONCURRENT_TOOLS=5
NEXUS_TOOL_TIMEOUT=300

# ── Guardrails ──
NEXUS_ALLOWED_TARGETS=localhost,127.0.0.1,example.com,test.com
NEXUS_LEGAL_ACK=I_HAVE_WRITTEN_AUTHORIZATION
NEXUS_RATE_LIMIT_CALLS=100
NEXUS_RATE_LIMIT_WINDOW=60

# ── MCP Server ──
NEXUS_MCP_PORT=8888

# ── Database ──
POSTGRES_DSN=postgresql://nexus:nexus@localhost:5432/nexus
REDIS_DSN=redis://localhost:6379/0