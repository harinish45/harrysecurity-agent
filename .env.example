# Active LLM Provider — run `nexus providers` any time to see live cost/status
# for everything configured below. See README.md → "Running NEXUS-STRIKE for $0".
LLM_PROVIDER=ollama

# 🟢 FREE — 100% local, no API key, no request limit, no network dependency.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder:7b

# ── Cloud LLM providers (optional — only needed if LLM_PROVIDER selects one) ─
# 🟢 FREE TIER — build.nvidia.com, free developer credits, 50+ open models.
# NVIDIA_API_KEY=your-nvidia-api-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

# 🟢 FREE TIER — use a model with the ":free" suffix for $0/token (~20 req/min).
# OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# 🟢 FREE TIER — free token/dashboard quota (OpenAI-compatible relay).
# OMNIROUTE_API_KEY=your-omniroute-api-key-here
OMNIROUTE_BASE_URL=
OMNIROUTE_MODEL=gpt-4

# 🟢 FREE TIER — no credit card required; 30 req/min, 14,400 req/day.
# GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# 🟡 VERY LOW COST — not free, but among the cheapest paid options.
# DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 🔴 PAID ONLY — no free tier.
# OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo

# 🔴 PAID ONLY — no free tier.
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-opus-20240229

# 🔴 PAID ONLY — no free tier.
# AZURE_OPENAI_API_KEY=your-azure-openai-api-key-here
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_MODEL=gpt-4

# ❓ DEPENDS — free if pointed at a local server (LM Studio, Antigravity, etc.).
# CUSTOM_API_KEY=your-custom-provider-api-key-here
CUSTOM_BASE_URL=
CUSTOM_MODEL=custom-model
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096

NEXUS_LEGAL_ACK=I_HAVE_WRITTEN_AUTHORIZATION
NEXUS_ALLOWED_TARGETS=127.0.0.1,localhost,scanme.nmap.org,testphp.vulnweb.com
NEXUS_MODE=guided
NEXUS_LOG_LEVEL=INFO
NEXUS_SANDBOX_ENABLED=true
NEXUS_AUTO_APPROVE=false
NEXUS_MAX_CONCURRENT_TOOLS=5
NEXUS_TOOL_TIMEOUT=300
NEXUS_RATE_LIMIT_CALLS=100
NEXUS_RATE_LIMIT_WINDOW=60
NEXUS_MCP_PORT=8888

# ── Environment / hardening ──────────────────────────────────────────────
# "development" (default) keeps local-dev conveniences: dashboard usable with
# no token, insecure TLS allowed for private/loopback targets. "production" is
# a hard switch — web/server.py refuses to start with no NEXUS_DASHBOARD_TOKEN
# set, and other defaults tighten to match. Set this explicitly before any
# real deployment.
NEXUS_ENV=development

# ── Secrets vault (nexus/foundation/secrets.py) ──────────────────────────
# The vault encrypts stored secrets (API keys added via the vault, user
# accounts created by `nexus auth create-admin`, etc.) with a key derived
# from this value. If unset, a key is generated once and stored locally at
# $NEXUS_VAULT_DIR/secret.key (default: ~/.nexus/secret.key) — fine for a
# single local machine, but it means the vault can't be restored elsewhere
# and isn't rotated automatically. Set an explicit high-entropy value here
# in production (e.g. `openssl rand -base64 32`) and keep it somewhere safe
# — losing it makes every stored secret permanently unrecoverable.
# NEXUS_MASTER_KEY=
# Where the vault's key/store files live. Point this at a persistent,
# non-tmpfs, bind-mounted path in containerized deployments (see
# docker-compose.yml's `nexus` service for the pattern).
# NEXUS_VAULT_DIR=~/.nexus

# ── Dashboard authentication ──────────────────────────────────────────────
# Required when NEXUS_ENV=production. Clients send it as
# `Authorization: Bearer <token>`. Generate one with, e.g., `openssl rand
# -hex 32`. Leave unset for local-only development use.
# NEXUS_DASHBOARD_TOKEN=
# Require a TOTP code (in addition to a password) for `nexus auth`-managed
# user accounts. Off by default; the dashboard's own token auth above is
# independent of this and unaffected either way.
# NEXUS_REQUIRE_2FA=false
# Comma-separated list of origins allowed to make cross-origin requests to
# the dashboard API. Empty (the default) means same-origin only — safe, not
# broken; only set this if you're embedding the dashboard from another origin.
# NEXUS_DASHBOARD_CORS_ORIGINS=
# Where the dashboard's own audit log is written (JSON lines, hash-chained
# for tamper evidence — see AuditGuard.verify_chain()).
# NEXUS_AUDIT_LOG=./nexus_audit.log

# ── TLS ─────────────────────────────────────────────────────────────────
# Every tool that connects over HTTPS/TLS verifies certificates by default
# now (see nexus/foundation/ssl_config.py). A tool may still request an
# insecure context for legitimate reasons (inspecting a target's own,
# possibly self-signed, certificate as part of a TLS/cert-testing engagement)
# — that request is honoured automatically for private/loopback targets, and
# otherwise only if you set this explicitly. Never set this to scan public
# internet hosts you don't control the certificate chain for.
# NEXUS_ALLOW_INSECURE_TLS=false
