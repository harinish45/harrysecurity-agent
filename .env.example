# =============================================================================
# NEXUS-STRIKE Configuration Example
# Copy this file to .env and set your preferred LLM provider & settings.
# DO NOT COMMIT YOUR REAL .env FILE TO GIT!
# =============================================================================

# Active LLM Provider: ollama | custom | nvidia | openrouter | groq | openai | anthropic | azure | deepseek
LLM_PROVIDER=ollama

# =============================================================================
# 1. Local Ollama (FREE — 100% Private, No API key needed)
# =============================================================================
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder:latest

# =============================================================================
# 2. OmniRoute / Custom Gateway (Multi-provider routing)
# =============================================================================
CUSTOM_BASE_URL=http://127.0.0.1:20128/v1
CUSTOM_MODEL=auto/best-coding
CUSTOM_API_KEY=your_omniroute_key_here

# =============================================================================
# 3. NVIDIA NIM (Free tier API available)
# =============================================================================
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_API_KEY=nvapi-...

# =============================================================================
# 4. OpenRouter (Gateway to 200+ free & paid models)
# =============================================================================
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_API_KEY=sk-or-...

# =============================================================================
# 5. Groq (Ultra-fast LPU inference)
# =============================================================================
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant
GROQ_API_KEY=gsk_...

# =============================================================================
# 6. OpenAI
# =============================================================================
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# =============================================================================
# 7. Anthropic (Claude)
# =============================================================================
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# =============================================================================
# Guardrails & Authorization (AUTHORIZED TESTING ONLY)
# =============================================================================
NEXUS_ALLOWED_TARGETS=localhost,127.0.0.1,example.com,test.com
NEXUS_LEGAL_ACK=I_HAVE_WRITTEN_AUTHORIZATION
NEXUS_RATE_LIMIT_CALLS=100
NEXUS_RATE_LIMIT_WINDOW=60

# =============================================================================
# Execution Settings
# =============================================================================
NEXUS_MODE=guided           # autonomous, guided, tool, interactive
NEXUS_LOG_LEVEL=INFO        # DEBUG, INFO, WARNING, ERROR
NEXUS_SANDBOX_ENABLED=true
NEXUS_TOOL_TIMEOUT=300